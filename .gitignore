# This workspace also contains a supplied Windows application and private runtime data.
# Only the maintained controller, Linux service, portable core and deployment sources
# belong in the repository. New top-level paths require an explicit opt-in.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/GIAO_CA.md
!/GITHUB_UBUNTU.md
!/2_MO_QUAN_LY_VPS.bat
!/control/
!/clone/
!/vps/
!/deploy/
!/tools/
!/.github/

__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*
*.env
*.env.*
!.env.example
!*.env.example
*.key
*.pem
id_ed25519*
*.db
*.db-*
*.sqlite*
*.csv
*.log
*.txt
!requirements*.txt
!CMakeLists.txt
data/
vps-data/
logs/
backups/
scratch/
runtime/
dist/
build/
*.exe
*.dll
*.pyd
*.zip
*.bak*
*.orig*
*settings.json
*config.json
*cookies*
*session*.json
*token*.json

# The Linux package uses clone/core only. The old clone GUI is a separate project.
/clone/*
!/clone/core/
!/clone/test_miraimind.py
!/clone/README.md
/control/qt.conf
